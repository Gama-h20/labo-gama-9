
#include <iostream>
#include <fstream>
#include <string>

using namespace std;

int main() {
    ifstream archivo("texto.txt");
    string linea;
    int contador = 0;

    if (!archivo.is_open()) {
        cout << "Error: No se pudo abrir el archivo." << endl;
    }
    else {
        while (getline(archivo, linea)) {
            contador++;
        }

        cout << "El archivo contiene " << contador << " lineas." << endl;

        archivo.close();
    }

    return 0;
}
